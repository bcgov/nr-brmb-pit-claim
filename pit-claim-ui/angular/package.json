{
  "name": "pit-claim",
  "version": "2.5.3-SNAPSHOT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "serve": "ng serve",
    "start.prod": "ng serve --configuration production --sourceMap=true",
    "build": "ng build",
    "build.prod": "ng build --configuration production --base-href /pub/pit-claim/ && replace-in-file /ngsw:/g ngsw:pit-claim: dist/pit-claim/ngsw-worker.js --verbose --isRegex",
    "test": "ng test",
    "test-and-coverage": "ng test --browsers ChromeHeadlessCustom --watch=false --code-coverage",
    "test-dev": "ng test --reporters=mocha",
    "test-dev-chrome": "ng test --watch=true --browsers=Chrome",
    "test-dev-safari": "ng test --watch=true --browsers=Safari",
    "lint": "ng lint",
    "cr": "npm run lint && npm start.prod",
    "mavenbuild": "node --max_old_space_size=4096 node_modules/@angular/cli/bin/ng build --configuration production --output-path ../../../target/angular --base-href /pub/pit-claim/ && replace-in-file /ngsw:/g ngsw:pit-claim: ../../../target/angular/ngsw-worker.js --verbose --isRegex",
    "bundle-report": "webpack-bundle-analyzer dist/pit-claim/stats.json",
    "compodoc": "npx compodoc -p src/tsconfig.app.json"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "19.2.25",
    "@angular/cdk": "19.2.19",
    "@angular/common": "19.2.25",
    "@angular/core": "19.2.25",
    "@angular/forms": "19.2.25",
    "@angular/material": "19.2.19",
    "@angular/platform-browser": "19.2.25",
    "@angular/platform-browser-dynamic": "19.2.25",
    "@angular/router": "19.2.25",
    "@angular/service-worker": "19.2.25",
    "@busacca/ng-pick-datetime": "15.0.0",
    "@cirras/cirras-claims-api": "^2.5.3-SNAPSHOT",
    "@ngrx/effects": "19.2.1",
    "@ngrx/store": "19.2.1",
    "@ngrx/store-devtools": "19.2.1",
    "@wf1/wfcc-application-ui": "^1.3.0-SNAPSHOT",
    "angular-oauth2-oidc": "19.0.0",
    "angular2-uuid": "1.1.1",
    "deep-equal": "2.2.3",
    "moment": "2.30.1",
    "multiple-select": "1.7.0",
    "ngx-connection-service": "18.0.0",
    "ngx-mask": "19.0.7",
    "ngx-moment": "6.0.2",
    "ngx-pagination": "6.0.3",
    "rxjs": "7.8.2",
    "sass": "1.102.0",
    "scroll-into-view-if-needed": "3.1.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "19.2.27",
    "@angular-eslint/eslint-plugin": "19.8.1",
    "@angular-eslint/eslint-plugin-template": "19.8.1",
    "@angular/cli": "19.2.27",
    "@angular/compiler": "19.2.25",
    "@angular/compiler-cli": "19.2.25",
    "@angular/language-service": "19.2.25",
    "@types/node": "26.1.2",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "eslint": "9.39.5",
    "eslint-plugin-import": "2.32.0",
    "replace-in-file": "8.4.0",
    "ts-node": "10.9.2",
    "typescript": "5.8.3"
  }
}
